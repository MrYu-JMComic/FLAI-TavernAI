  },
  "dependencies": {
    "@lucide/vue": "1.49.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "markdown-it": "^15.0.2",
    "vue": "3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "vite": "8.3.1",
    "vitest": "^4.1.11"
