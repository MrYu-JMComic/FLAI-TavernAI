  },
  "dependencies": {
    "@lucide/vue": "1.61.0",
    "@tanstack/vue-virtual": "^3.13.47",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "vue": "3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "vite": "8.3.5",
    "vitest": "^4.1.11"
