{
  "name": "flai-tavern-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "pretest": "node ../scripts/check-encoding.mjs",
    "test": "node scripts/run-tests.mjs all",
    "test:backend": "node scripts/run-tests.mjs backend",
    "test:contracts": "node scripts/run-tests.mjs contracts",
    "test:coverage": "node scripts/run-tests.mjs backend --coverage",
    "backup:restore": "node scripts/restore-backup.mjs",
    "evaluate:context": "node scripts/evaluate-context-quality.mjs"
  },
  "dependencies": {
    "@dagrejs/graphlib": "4.0.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dompurify": "^3.4.14",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsdom": "^30.0.1",
    "lru-cache": "^11.5.2",
    "safe-regex2": "^5.1.1",
    "zod": "^4.5.4"
  }
}
